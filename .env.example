# Закреплённый ящик проекта для прайсов.
# Поставщики шлют на prajsy@sadparts.ru или на plus-алиас: prajsy+armtek@sadparts.ru
PRICE_MAILBOX_ADDRESS=prajsy@sadparts.ru

# Секрет входящего webhook. Без него POST /api/prices/email/inbound закрыт.
# Сгенерировать: openssl rand -hex 24
PRICE_MAILBOX_SECRET=

# IMAP того же ящика (Яндекс Почта для домена / Timeweb / любой IMAP).
# Нужен для кнопки «Забрать письма» и cron POST /api/prices/email/fetch
PRICE_IMAP_HOST=
PRICE_IMAP_PORT=993
PRICE_IMAP_USER=prajsy@sadparts.ru
PRICE_IMAP_PASS=
# 1 = TLS (993), 0 = без TLS
PRICE_IMAP_TLS=1
